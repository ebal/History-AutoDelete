{
  "manifest_version": 3,
  "name": "History AutoDelete",
  "version": "3.0.1",
  "description": "Keeps chosen domains and their subdomains out of your browser history.",
  "homepage_url": "https://github.com/mrdokenny/History-AutoDelete",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_icon": {
      "24": "icons/icon_24.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png"
    },
    "default_title": "History AutoDelete",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "history",
    "sessions",
    "storage",
    "tabs"
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "{7e79d10d-9667-4d38-838d-471281c568c3}",
      "strict_min_version": "121.0"
    }
  }
}
